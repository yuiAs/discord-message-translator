{
  "name": "discord-message-translator",
  "version": "1.1.0",
  "description": "Chrome Extension to translate Discord messages automatically",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "discord",
    "translator",
    "translation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.256",
    "@types/dom-chromium-ai": "^0.0.13",
    "@types/node": "^20.10.6",
    "@vitest/coverage-v8": "^1.6.1",
    "@vitest/ui": "^1.1.3",
    "autoprefixer": "^10.4.16",
    "daisyui": "^4.6.0",
    "happy-dom": "^12.10.3",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vitest": "^1.1.3",
    "wxt": "^0.20.14"
  }
}
